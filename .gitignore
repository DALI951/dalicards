# ---- secrets: NEVER commit ----
.secrets/
*.jks
*.keystore
KEYSTORE_SECRETS.txt
api/config.php
api/.env
api/data/
*.tar.gz
api/*.bak

# ---- flutter / dart ----
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
# Generated by `flutter create` on whichever machine ran it. The project is
# scaffolded fresh in CI on purpose, so pinning one machine's Flutter version
# here would only create drift.
.metadata
.idea/
.vscode/
.flutter-plugins-dependencies
pubspec.lock

# generated by CI (flutter create) - see plan M0
/android/
/ios/
/macos/
/windows/
/linux/
# The whole web shell is generated too. Committing it would only create drift
# against whatever Flutter version CI happens to be on. If the PWA ever needs a
# hand-written manifest, delete this line and own the file on purpose.
/web/
*.iml

# ---- node (screenshot harness) ----
node_modules/
/tmp_shots/

# ---- misc ----
Thumbs.db
desktop.ini
.DS_Store
*.log
